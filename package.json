{
  "name": "builtin.language-features-css-monorepo",
  "version": "0.0.0-dev",
  "description": "CSS language features for LVCE Editor",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:extension": "node packages/build/src/build-extension.js",
    "dev": "node ./node_modules/@lvce-editor/server/bin/server.js --only-extension=packages/extension --test-path=packages/e2e",
    "e2e": "npm run e2e --workspace=packages/e2e",
    "e2e:headless": "npm run e2e:headless --workspace=packages/e2e",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "npm test --workspaces --if-present",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "type-check": "tsc -b"
  },
  "author": {
    "name": "Le Vivilet",
    "email": "levivilet@pm.me"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@lvce-editor/api": "^8.75.0",
    "@lvce-editor/eslint-config": "^18.4.0",
    "@lvce-editor/server": "^0.91.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "eslint": "^10.8.1",
    "jest": "^30.2.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
