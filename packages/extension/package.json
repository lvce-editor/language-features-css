{
  "name": "builtin.language-features-css",
  "version": "0.0.0-dev",
  "description": "CSS language features extension for LVCE Editor",
  "main": "dist/languageFeaturesCssMain.js",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "author": {
    "name": "Le Vivilet",
    "email": "levivilet@pm.me"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@lvce-editor/api": "^8.75.0"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  }
}
